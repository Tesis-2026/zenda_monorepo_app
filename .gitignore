# ───────────────────────────────────────────
# Zenda Monorepo — .gitignore
# ───────────────────────────────────────────

# Claude Code local settings
.claude/settings.local.json

# ── Environment / secrets ──
.env
.env.local
.env.*.local
!.env.example

# ── Node.js (backend) ──
node_modules/
dist/
build/
*.js.map
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# ── Prisma ──
prisma/migrations/**/migration_lock.toml

# ── Flutter / Dart (frontend) ──
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
*.g.dart
*.freezed.dart
*.mocks.dart
lib/generated/
doc/api/

# ── Python (ml) ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
*.egg
.ipynb_checkpoints/
*.pkl
*.h5
*.tflite
*.pb
mlruns/
.mlflow/

# ── OS ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDEs ──
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── Logs ──
logs/
*.log

# ── Test coverage ──
coverage/
lcov.info
*.lcov
