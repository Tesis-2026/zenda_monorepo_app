  class AuthController {
    POST /auth/register
    POST /auth/login
    POST /auth/refresh
    POST /auth/logout
    POST /auth/forgot-password
    POST /auth/reset-password
  }
  class RegisterDto
  class LoginDto
  class AuthTokenResponseDto
  class UserId <<decorator>>
}

package "application/ (Orchestration)" {
  class RegisterUseCase
  class LoginUseCase
  class ForgotPasswordUseCase
  class ResetPasswordUseCase
  class RefreshAccessTokenUseCase
  class LogoutUseCase
}

package "domain/ (Pure TypeScript — zero NestJS decorators)" {
  abstract class IUserRepository <<port>>
  abstract class IPasswordResetTokenRepository <<port>>
  abstract class IRefreshTokenRepository <<port>>
  class UserDomain <<aggregate>>
}

package "infrastructure/ (Adapters)" {
  class PrismaUserRepository
  class PrismaPasswordResetRepository
  class PrismaRefreshTokenRepository
  class JwtStrategy <<Passport>>
