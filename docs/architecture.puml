' ─────────────────────────────────────────────────────────────
' DIAGRAM 6 — Database ERD (Core Models)
' ─────────────────────────────────────────────────────────────
@startuml ZendaERD
!theme plain
skinparam backgroundColor #FAFAFA
skinparam linetype ortho

title Zenda — Database ERD (Core Models)

entity User {
  * id : UUID PK
  --
  * email : TEXT UNIQUE
  * passwordHash : TEXT
  * fullName : TEXT
  age : INT?
  university : TEXT?
  incomeType : ENUM?
  averageMonthlyIncome : Decimal(12,2)?
  financialLiteracyLevel : ENUM?
  profileCompleted : BOOL
  currency : VARCHAR(3)
  consentGiven : BOOL
  consentAt : DateTime?
  deletedAt : DateTime?
}

entity Transaction {
  * id : UUID PK
  --
  * userId : UUID FK
  categoryId : UUID FK?
  * type : INCOME|EXPENSE
  * amount : Decimal(12,2)
  description : TEXT?
  occurredAt : DateTime
  deletedAt : DateTime?
}

entity Category {
  * id : UUID PK
  --
  * name : TEXT
  * type : SYSTEM|CUSTOM
  transactionType : ENUM?
  userId : UUID FK? (null = system)
  deletedAt : DateTime?
}

entity Budget {
  * id : UUID PK
  --
  * userId : UUID FK
  categoryId : UUID FK?
  * amountLimit : Decimal(12,2)
  * month : INT
  * year : INT
  deletedAt : DateTime?
  .. unique constraint ..
  userId + categoryId + month + year
}

entity SavingsGoal {
  * id : UUID PK
  --
  * userId : UUID FK
  * name : TEXT
  * targetAmount : Decimal(12,2)
  currentAmount : Decimal(12,2)
  targetDate : DateTime?
  deletedAt : DateTime?
}

entity GoalContribution {
  * id : UUID PK
  --
  * goalId : UUID FK
  * amount : Decimal(12,2)
  createdAt : DateTime
}

entity PasswordResetToken {
  * id : UUID PK
  --
  * userId : UUID FK
  * token : TEXT UNIQUE
  * expiresAt : DateTime
  usedAt : DateTime?
}

entity RefreshToken {
  * id : UUID PK
  --
  * userId : UUID FK
  * token : TEXT UNIQUE
  * expiresAt : DateTime
}

entity Prediction {
  * id : UUID PK
  --
  * userId : UUID FK
  * period : TEXT (YYYY-MM)
  * type : INCOME|EXPENSE
  * predictedTotal : Decimal(12,2)
  predictedByCategory : JSON?
  confidenceInterval : JSON?
  actualTotal : Decimal(12,2)?
  accuracy : Decimal(5,2)?
  .. unique constraint ..
  userId + period + type
}

entity Recommendation {
  * id : UUID PK
  --
  * userId : UUID FK
  * type : SAVINGS|BUDGET|GOAL
  * message : TEXT
  suggestedAction : TEXT?
}

entity Challenge {
  * id : UUID PK
  --
  title : TEXT
  criteriaJson : JSON
}

entity UserChallenge {
  * id : UUID PK
  --
  * userId : UUID FK
  * challengeId : UUID FK
  * status : AVAILABLE|ACTIVE|COMPLETED
  acceptedAt : DateTime?
  completedAt : DateTime?
}

entity Badge {
  * id : UUID PK
  --
  * name : TEXT UNIQUE
  description : TEXT
  criteria : TEXT
}

entity UserBadge {
  * id : UUID PK
  --
  * userId : UUID FK
  * badgeId : UUID FK
  earnedAt : DateTime
}

User ||--o{ Transaction : "has"
User ||--o{ Category : "creates custom"
User ||--o{ Budget : "defines"
User ||--o{ SavingsGoal : "sets"
User ||--o{ PasswordResetToken : "owns"
User ||--o{ RefreshToken : "owns"
User ||--o{ Prediction : "has"
User ||--o{ Recommendation : "receives"
User ||--o{ UserChallenge : "participates"
User ||--o{ UserBadge : "earns"

Transaction }o--|| Category : "classified by"
Budget }o--o| Category : "targets"
SavingsGoal ||--o{ GoalContribution : "receives"

Challenge ||--o{ UserChallenge : "assigned via"
Badge ||--o{ UserBadge : "awarded via"

@enduml


' ─────────────────────────────────────────────────────────────
' DIAGRAM 7 — Request Lifecycle (Authenticated API Call)
' ─────────────────────────────────────────────────────────────
@startuml ZendaRequestLifecycle
!theme plain
skinparam backgroundColor #FAFAFA

title Zenda — Authenticated API Request Lifecycle

participant "Flutter\nApiClient" as Client
participant "ThrottlerGuard\n(120 req/min)" as Throttle
participant "Helmet +\nCORS Middleware" as Security
participant "RequestLogging\nInterceptor" as Logger
participant "JwtAuthGuard\n(Passport)" as JWT
participant "ValidationPipe\n(class-validator)" as Validate
participant "Controller" as Ctrl
participant "UseCase" as UC
participant "Repository\n(Infrastructure)" as Repo
participant "PrismaService" as Prisma
participant "GlobalException\nFilter" as ErrFilter
participant "PostgreSQL" as DB

Client -> Throttle : incoming request
Throttle -> Security : passes rate limit check
Security -> Logger : sets security headers + CORS
Logger -> JWT : logs request start + timer
JWT -> JWT : verifies Bearer token\nextracts userId
JWT -> Validate : injects userId into req.user
Validate -> Ctrl : validates DTO shape + constraints
Ctrl -> UC : calls use case with DTO + userId
UC -> Repo : calls repository port (abstract class)
Repo -> Prisma : Prisma query (includes deletedAt: null)
Prisma -> DB : SQL
DB --> Prisma : rows
Prisma --> Repo : raw Prisma result
Repo --> UC : mapped domain entity
UC --> Ctrl : domain result
Ctrl -> Logger : wraps in SuccessResponseDto
Logger --> Client : 200 { data, success } + elapsed logged

note over ErrFilter
  On any thrown exception,
  GlobalExceptionFilter catches it
  and maps to structured error JSON
  before the response is sent.
end note

@enduml
