@startuml ZendaFlutterArch
skinparam backgroundColor #FAFAFA
skinparam linetype ortho

title Zenda Flutter -- Feature Architecture

package "main.dart + MaterialApp.router" {
  [routerProvider\n(GoRouter + Riverpod)] as Router
  [AuthNotifier\n(authNotifierProvider)] as AuthNotifier
}

package "features/" {
  package "auth/" {
    [LoginScreen]
    [RegisterScreen]
    [ForgotPasswordScreen]
    [ResetPasswordScreen]
  }
  package "onboarding/" {
    [SplashDecider]
    [OnboardingScreen]
  }
  package "dashboard/" {
    [DashboardScreen\n(4-tab PageView)]
    [SummaryCard]
    [BudgetPieChart\n(fl_chart 50/30/20)]
    [ZendaAiCard]
    [StreakCard]
  }
  package "transactions/" {
    [AddTransactionScreen]
    [TransactionListScreen\n(filter chips)]
    [NewTransactionController]
  }
  package "budget/" {
    [BudgetScreen\n(progress bars)]
  }
  package "goals/" {
    [GoalsScreen]
    [GoalDetailScreen]
  }
  package "reports/" {
    [ReportsScreen\n(charts + PDF export)]
  }
  package "categories/" {
    [CategoryManagementScreen]
  }
  package "profile/" {
    [ProfileScreen]
  }
}

package "core/services/ (API Layer)" {
  [ApiClient\n(HTTP + auto token refresh)] as ApiClient
  [AuthApiService] as AuthSvc
  [UserApiService] as UserSvc
  [TransactionsRepository] as TxRepo
  [BudgetApiService] as BudgetSvc
  [GoalsApiService] as GoalsSvc
  [CategoryApiService] as CatSvc
}

package "providers/ (Riverpod)" {
  [authNotifierProvider\nNotifier of AuthState] as AuthProv
  [budgetProvider\nAsyncNotifier] as BudgetProv
  [goalsProvider\nAsyncNotifier] as GoalsProv
  [streakNotifier] as StreakProv
}

package "Local Storage" {
  [flutter_secure_storage\n(JWT tokens)] as SecStore
  [SharedPreferences\n(locale, onboarding prefs)] as Prefs
}

package "l10n/" {
  [AppLocalizations\n(EN + ES ARB)] as L10n
}

Router --> AuthNotifier : refreshListenable
Router --> LoginScreen
Router --> DashboardScreen
Router --> AddTransactionScreen

AuthSvc --> ApiClient
UserSvc --> ApiClient
TxRepo --> ApiClient
BudgetSvc --> ApiClient
GoalsSvc --> ApiClient
CatSvc --> ApiClient

ApiClient --> SecStore : read/write tokens
AuthSvc --> SecStore : persist after login

AuthProv --> AuthSvc
BudgetProv --> BudgetSvc
GoalsProv --> GoalsSvc

DashboardScreen --> AuthProv
DashboardScreen --> BudgetProv
DashboardScreen --> StreakProv
BudgetScreen --> BudgetProv
GoalsScreen --> GoalsProv

@enduml
