              "children": [
                {
                  "type": "text",
                  "id": "Vaeot",
                  "name": "det_s1title",
                  "fill": "#1F2937",
                  "content": "What is the 50/30/20 rule?",
                  "fontFamily": "Inter",
                  "fontSize": 17,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "DYmKv",
                  "name": "det_s1body",
                  "fill": "#374151",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The 50/30/20 rule is a simple budgeting method that divides your after-tax income into three categories: needs, wants, and savings.\n\n• 50% for needs (rent, food, utilities)\n• 30% for wants (dining out, hobbies)\n• 20% for savings and debt repayment",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "6fY8Z",
              "name": "det_section2",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "2Jymm",
                  "name": "det_s2title",
                  "fill": "#1F2937",
                  "content": "Why it works for students",
                  "fontFamily": "Inter",
                  "fontSize": 17,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "PxAQz",
                  "name": "det_s2body",
                  "fill": "#374151",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "University students in Peru often have irregular income from part-time jobs or family support. The 50/30/20 rule provides a flexible structure that adapts to variable income.",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
